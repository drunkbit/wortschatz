# Kopieren nach tools/.env und Werte eintragen.
# Die Datei wird nicht versioniert; bereits gesetzte Umgebungsvariablen
# haben Vorrang vor den Werten aus dieser Datei.

# Erforderlich für `npm run quality` (außer bei --dry-run)
OPENROUTER_API_KEY=sk-or-...

# Optional
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
